{
  "version": 3,
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/token",
      "dest": "/api/token"
    },
    {
      "src": "/api/legacy-tokens",
      "dest": "/api/legacy-tokens"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}